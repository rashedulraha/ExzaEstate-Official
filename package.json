{
  "name": "exzaestate",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint -c packages/config/oxlint.json && depcruise --config packages/config/.dependency-cruiser.cjs apps packages && node packages/config/check-cycles.mjs",
    "lint:oxlint": "oxlint -c packages/config/oxlint.json",
    "lint:boundaries": "depcruise --config packages/config/.dependency-cruiser.cjs apps packages",
    "lint:cycles": "node packages/config/check-cycles.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node ./apps/web/node_modules/vitest/vitest.mjs run --config e2e/vitest.config.mjs",
    "start:dev": "node --env-file=.env --import ./scripts/swc-register.mjs apps/backend/src/main.ts",
    "start:local": "node --env-file=.env --import ./scripts/swc-register.mjs apps/backend/src/main.local.ts",
    "db:generate": "pnpm --filter @exzaestate/backend exec prisma generate",
    "postinstall": "pnpm db:generate && pnpm --filter @exzaestate/shared build",
    "db:seed": "pnpm --filter @exzaestate/backend seed",
    "db:seed:demo": "pnpm --filter @exzaestate/backend seed:demo",
    "db:clean": "pnpm --filter @exzaestate/backend clean:database",
    "db:clean:md": "pnpm db:clean && pnpm db:seed",
    "db:reset": "pnpm --filter @exzaestate/backend exec prisma migrate reset --force",
    "gen:api": "node --import ./scripts/swc-register.mjs apps/backend/src/openapi-export.ts && pnpm --filter @exzaestate/api-client gen && prettier --write packages/api-client/openapi.json",
    "check:all": "node scripts/check-all.mjs",
    "check:acceptance": "node scripts/check-acceptance-matrix.mjs",
    "check:booking-index": "node scripts/check-booking-statuses-index.mjs",
    "check:openapi-breaking": "node scripts/check-openapi-breaking.mjs",
    "check:prelaunch": "node scripts/check-prelaunch.mjs",
    "verify:backup-drill": "node scripts/verify-backup-drill.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "dependency-cruiser": "18.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "madge": "8.0.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.10",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint -c packages/config/oxlint.json",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "argon2",
      "esbuild",
      "msw",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
